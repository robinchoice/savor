{
  "name": "savor-desktop",
  "productName": "Savor",
  "version": "0.6.2",
  "description": "Local-first workspace for CLI coding agents",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/robinchoice/savor.git"
  },
  "homepage": "https://github.com/robinchoice/savor",
  "author": {
    "name": "Savor contributors"
  },
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "dist": "npm --prefix .. run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.savor.app",
    "productName": "Savor",
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "savor",
        "filter": [
          "server/**",
          "web/**"
        ]
      },
      {
        "from": "../node_modules/playwright-core",
        "to": "savor/node_modules/playwright-core"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "../node_modules/node-pty",
          "to": "savor/node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**/*.js",
            "!lib/**/*.test.js",
            "prebuilds/linux-*/**"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "../node_modules/node-pty",
          "to": "savor/node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**/*.js",
            "!lib/**/*.test.js",
            "prebuilds/darwin-*/**"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "../node_modules/node-pty",
          "to": "savor/node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**/*.js",
            "!lib/**/*.test.js",
            "prebuilds/win32-x64/**",
            "!**/*.pdb"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "robinchoice",
        "repo": "savor",
        "releaseType": "draft"
      }
    ]
  },
  "desktopName": "savor.desktop"
}
