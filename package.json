{
  "name": "savor",
  "version": "0.6.17",
  "description": "Local-first workspace for CLI coding agents (Claude Code, Codex, OpenCode)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/robinchoice/savor.git"
  },
  "homepage": "https://github.com/robinchoice/savor",
  "type": "module",
  "bin": {
    "savor": "bin/savor.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build && npm run build:server && npm run build:relay",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server/index.mjs --external:playwright-core --external:node-pty --banner:js=\"import { createRequire as __cjsRequire } from 'node:module'; const require = __cjsRequire(import.meta.url);\" && esbuild server/voice-worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server/voice-worker.mjs --external:transcribe-cpp",
    "build:relay": "esbuild relay/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/relay/server.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire as __cjsRequire } from 'node:module'; const require = __cjsRequire(import.meta.url);\"",
    "prepare": "npm run build",
    "start": "node bin/savor.js",
    "relay": "node dist/relay/server.mjs",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "flock /tmp/savor-test.lock node --import tsx --test --test-concurrency=2 \"test/*.test.mjs\"",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@sentry/browser": "^11.4.0",
    "@sentry/node": "^11.4.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "node-pty": "1.2.0-beta.15",
    "playwright-core": "^1.63.0",
    "transcribe-cpp": "0.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@tiptap/core": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "lucide-preact": "^1.48.0",
    "marked": "^18.0.14",
    "modern-screenshot": "^4.7.0",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ]
}
