{
  "name": "savor",
  "version": "0.1.0",
  "description": "Local-first workspace for CLI coding agents (Claude Code, Codex, OpenCode)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/robinchoice/savor.git"
  },
  "homepage": "https://github.com/robinchoice/savor",
  "type": "module",
  "bin": {
    "savor": "bin/savor.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server/index.mjs --external:playwright-core --banner:js=\"import { createRequire as __cjsRequire } from 'node:module'; const require = __cjsRequire(import.meta.url);\"",
    "prepare": "npm run build",
    "dev:web": "vite",
    "start": "node bin/savor.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "croner": "^10.0.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "lucide-preact": "^1.48.0",
    "marked": "^18.0.14",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ]
}
